{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mertsgi.org/aos/v0.1/verification_result.schema.json",
  "title": "AOS Verification Result Schema",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "task_id",
    "gate",
    "disposition",
    "verifier",
    "verified_at",
    "checks",
    "authorizes_canonical_closure"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.[0-9]+)?$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "gate": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "type": "string",
      "enum": [
        "PASS",
        "HOLD"
      ]
    },
    "verifier": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_base_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "control_source_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "authorizes_canonical_closure": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
