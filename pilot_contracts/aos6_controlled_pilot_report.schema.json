{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AOS6ControlledPilotReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pilot_run_id",
    "aos_canonical_binding_sha",
    "lari_source_sha",
    "pilot_execution_environment",
    "aos6_controlled_pilot_result",
    "exact_sha_result",
    "environment_isolation_result",
    "synthetic_data_only_result",
    "runtime_boot_result",
    "runtime_boot_class",
    "bounded_workflow_result",
    "evidence_capture_result",
    "cleanup_result",
    "source_mutation_count",
    "canonical_lari_mutation_count",
    "authorized_source_acquisition_count",
    "canonical_remote_access_count",
    "lari_e3_project_access_count",
    "shared_staging_access_count",
    "production_access_count",
    "vercel_access_count",
    "real_customer_data_access_count",
    "real_whatsapp_send_count",
    "real_sms_send_count",
    "real_email_send_count",
    "real_payment_count",
    "real_provider_network_call_count",
    "mock_provider_call_count",
    "surviving_disposable_resource_count",
    "attempt_count",
    "retry_count",
    "first_failed_step_if_any",
    "blocker_if_any",
    "stage12c_authority",
    "production_authority",
    "controller_review_required",
    "runtime_evidence_binding"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "pilot_run_id": { "type": "string" },
    "aos_canonical_binding_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "lari_source_sha": { "type": "string", "const": "cc9c55e7fc841f4f16137b0a5e7c6f04b44b631a" },
    "pilot_execution_environment": { "type": "string", "const": "AOS_OWNED_ISOLATED_DISPOSABLE_SYNTHETIC_NONCANONICAL" },
    "aos6_controlled_pilot_result": { "type": "string", "enum": ["PASS", "FAIL", "HOLD"] },
    "exact_sha_result": { "type": "string", "enum": ["PASS", "FAIL"] },
    "environment_isolation_result": { "type": "string", "enum": ["PASS", "FAIL"] },
    "synthetic_data_only_result": { "type": "string", "enum": ["PASS", "FAIL"] },
    "runtime_boot_result": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_CHECKED"] },
    "runtime_boot_class": { "type": "string", "const": "NODE_TSX_PRODUCT_POLICY_MODULE" },
    "bounded_workflow_result": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_CHECKED"] },
    "evidence_capture_result": { "type": "string", "enum": ["PASS", "FAIL", "NOT_CHECKED"] },
    "cleanup_result": { "type": "string", "enum": ["PASS", "FAIL", "NOT_CHECKED"] },
    "source_mutation_count": { "type": "integer", "minimum": 0 },
    "canonical_lari_mutation_count": { "type": "integer", "minimum": 0 },
    "authorized_source_acquisition_count": { "type": "integer", "minimum": 0, "maximum": 1 },
    "canonical_remote_access_count": { "type": "integer", "minimum": 0 },
    "lari_e3_project_access_count": { "type": "integer", "minimum": 0 },
    "shared_staging_access_count": { "type": "integer", "minimum": 0 },
    "production_access_count": { "type": "integer", "minimum": 0 },
    "vercel_access_count": { "type": "integer", "minimum": 0 },
    "real_customer_data_access_count": { "type": "integer", "minimum": 0 },
    "real_whatsapp_send_count": { "type": "integer", "minimum": 0 },
    "real_sms_send_count": { "type": "integer", "minimum": 0 },
    "real_email_send_count": { "type": "integer", "minimum": 0 },
    "real_payment_count": { "type": "integer", "minimum": 0 },
    "real_provider_network_call_count": { "type": "integer", "minimum": 0 },
    "mock_provider_call_count": { "type": "integer", "minimum": 0 },
    "surviving_disposable_resource_count": { "type": "integer", "minimum": 0 },
    "attempt_count": { "type": "integer", "minimum": 0, "maximum": 1 },
    "retry_count": { "type": "integer", "minimum": 0, "maximum": 0 },
    "first_failed_step_if_any": { "type": ["string", "null"] },
    "blocker_if_any": { "type": ["string", "null"] },
    "stage12c_authority": { "type": "string", "const": "NOT_AUTHORIZED" },
    "production_authority": { "type": "string", "const": "NO" },
    "controller_review_required": { "type": "boolean", "const": true },
    "runtime_evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_filename", "manifest_sha256", "manifest_schema_version"],
      "properties": {
        "manifest_filename": { "type": "string", "const": "pilot_runtime_manifest.json" },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifest_schema_version": { "type": "string", "const": "0.1.0" }
      }
    }
  }
}
