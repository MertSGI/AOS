{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos.local/schemas/runtime-contract-v1.schema.json",
  "title": "AOS Runtime Contract V1 Continue Project Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "command_type",
    "command_id",
    "project",
    "goal",
    "production",
    "ag_backend_enabled"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "command_type": {"const": "continue_project"},
    "command_id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{1,96}$"},
    "created_at": {"type": "string"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "descriptor_path", "workspace", "routing_policy_path", "standing_authority"],
      "properties": {
        "project_id": {"type": "string"},
        "descriptor_path": {"type": "string"},
        "workspace": {"type": "string"},
        "routing_policy_path": {"type": "string"},
        "standing_authority": {"type": "boolean"}
      }
    },
    "goal": {"type": "string", "minLength": 1, "maxLength": 8000},
    "constraints": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
    "red_lines": {"type": "array", "items": {"type": "string"}, "maxItems": 64},
    "max_batches_per_cycle": {"type": "integer", "minimum": 1, "maximum": 50},
    "max_iterations_per_batch": {"type": "integer", "minimum": 1, "maximum": 500},
    "continuous": {"type": "boolean"},
    "production": {"const": "NO_GO"},
    "ag_backend_enabled": {"const": false}
  }
}
