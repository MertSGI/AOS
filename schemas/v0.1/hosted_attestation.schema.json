{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mertsgi.org/aos/v0.1/hosted_attestation.schema.json",
  "title": "AOS Hosted Attestation Schema",
  "type": "object",
  "required": [
    "schema_version",
    "aos_source_sha",
    "report_sha256",
    "runtime_manifest_sha256",
    "worktree_immutable_result"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.[0-9]+)?$"
    },
    "aos_source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "worktree_immutable_result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    }
  }
}
