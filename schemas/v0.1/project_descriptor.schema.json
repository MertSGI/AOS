{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mertsgi.org/aos/v0.1/project_descriptor.schema.json",
  "title": "AOS Project Descriptor Schema",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "repository",
    "control",
    "authority"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.[0-9]+)?$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "control": {
      "type": "object",
      "required": [
        "state",
        "decisions",
        "evidence",
        "roadmap"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "roadmap": {
          "type": "string",
          "minLength": 1
        },
        "charter": {
          "type": "string"
        },
        "autonomy_policy": {
          "type": "string"
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "production_mutation",
        "roadmap_change",
        "destructive_data"
      ],
      "additionalProperties": false,
      "properties": {
        "production_mutation": {
          "type": "string",
          "enum": [
            "human_required",
            "autonomous_allowed",
            "forbidden"
          ]
        },
        "roadmap_change": {
          "type": "string",
          "enum": [
            "human_required",
            "autonomous_allowed",
            "forbidden"
          ]
        },
        "destructive_data": {
          "type": "string",
          "enum": [
            "human_required",
            "autonomous_allowed",
            "forbidden"
          ]
        },
        "security_boundary_change": {
          "type": "string",
          "enum": [
            "human_required",
            "autonomous_allowed",
            "forbidden"
          ]
        },
        "payment_activation": {
          "type": "string",
          "enum": [
            "human_required",
            "autonomous_allowed",
            "forbidden"
          ]
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch_prefix": {
          "type": "string"
        },
        "isolated_worktree_required": {
          "type": "boolean"
        },
        "max_concurrent_workers": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
