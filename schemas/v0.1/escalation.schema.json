{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mertsgi.org/aos/v0.1/escalation.schema.json",
  "title": "AOS Escalation / HOLD Event Schema",
  "type": "object",
  "required": [
    "schema_version",
    "escalation_id",
    "timestamp",
    "project_id",
    "gate",
    "trigger",
    "status",
    "reason",
    "observed_state",
    "expected_state",
    "required_decision"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.[0-9]+)?$"
    },
    "escalation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "task_id": {
      "type": "string"
    },
    "gate": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "enum": [
        "ROADMAP_CHANGE",
        "MATERIAL_SCOPE_CHANGE",
        "PRODUCTION_MUTATION_REQUESTED",
        "DESTRUCTIVE_DATA_OPERATION",
        "SECURITY_OR_AUTH_BOUNDARY_CHANGE",
        "PAYMENT_OR_BILLING_ACTIVATION",
        "SECRET_OR_TRUST_MODEL_CHANGE",
        "EVIDENCE_CONTRADICTION",
        "EVIDENCE_WAIVER_REQUESTED",
        "RETRY_CEILING_EXCEEDED",
        "BASE_SHA_MISMATCH",
        "SCOPE_VIOLATION",
        "SCHEMA_INVALID",
        "VERIFIER_UNRESOLVED",
        "COORDINATION_AMBIGUITY"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["HOLD", "RESOLVED", "REJECTED"],
      "default": "HOLD"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "observed_state": {
      "type": "object",
      "additionalProperties": true
    },
    "expected_state": {
      "type": "object",
      "additionalProperties": true
    },
    "required_decision": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option_id", "description"],
        "additionalProperties": false,
        "properties": {
          "option_id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "impact": { "type": "string" }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
