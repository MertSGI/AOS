{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mertsgi.org/aos/v0.1/decision_event.schema.json",
  "title": "AOS Decision Event Schema",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "timestamp",
    "project",
    "title",
    "status",
    "decision",
    "rationale",
    "authority"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.[0-9]+)?$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^AOS-DEC-[0-9]{3,}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["ACCEPTED", "ACCEPTED_AS_BASELINE", "ACCEPTED_AS_INITIAL_ADAPTER", "PROVISIONAL", "SUPERSEDED", "REJECTED"]
    },
    "supersedes": {
      "type": "string",
      "pattern": "^AOS-DEC-[0-9]{3,}$"
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "required": ["type", "actor"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["HUMAN_PRODUCT_OWNER", "AUTONOMOUS_CONTROLLER", "PLANNER_CONSENSUS"] },
        "actor": { "type": "string", "minLength": 1 }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}