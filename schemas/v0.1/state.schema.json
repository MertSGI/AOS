{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mertsgi.org/aos/v0.1/state.schema.json",
  "title": "AOS State Schema",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "project",
    "status",
    "current_gate",
    "delivery_train",
    "principles",
    "next_action"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^0\\.1(\\.[0-9]+)?$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "object",
      "required": ["name", "purpose"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "expanded_name": { "type": "string" },
        "working_name_status": { "type": "string" },
        "purpose": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "current_gate": {
      "type": "string",
      "pattern": "^AOS-[0-9]+$"
    },
    "delivery_train": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "principles": {
      "type": "object",
      "required": [
        "fail_closed",
        "evidence_over_claims",
        "exact_revision_required",
        "planner_executor_verifier_separation",
        "human_critical_authority",
        "portable_multi_project",
        "multi_pc_required",
        "canonical_truth_in_version_control"
      ],
      "properties": {
        "fail_closed": { "type": "boolean" },
        "evidence_over_claims": { "type": "boolean" },
        "exact_revision_required": { "type": "boolean" },
        "planner_executor_verifier_separation": { "type": "boolean" },
        "human_critical_authority": { "type": "boolean" },
        "portable_multi_project": { "type": "boolean" },
        "multi_pc_required": { "type": "boolean" },
        "canonical_truth_in_version_control": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "initial_integrations": {
      "type": "object",
      "additionalProperties": true
    },
    "lari_pilot": {
      "type": "object",
      "additionalProperties": true
    },
    "human_gate_default": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "implementation_started": {
      "type": "boolean"
    },
    "accepted_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "name", "status", "evidence_level", "closed_at"],
        "properties": {
          "gate": { "type": "string", "pattern": "^AOS-[0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["CLOSED_PROVEN", "ACCEPTED", "IN_PROGRESS", "OPEN", "HOLD"] },
          "evidence_level": { "type": "string", "minLength": 1 },
          "foundation_baseline_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "verified_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "closed_at": { "type": "string", "format": "date-time" },
          "reopen_condition": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}