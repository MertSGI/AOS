{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mertsgi.org/aos/v0.1/state.schema.json",
  "title": "AOS State Schema",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "next_action"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "purpose"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expanded_name": {
          "type": "string"
        },
        "working_name_status": {
          "type": "string"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "product": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "current_status": {
      "type": "string"
    },
    "current_gate": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "current_milestone": {
      "type": "string"
    },
    "delivery_train": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "master_delivery_train": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delivery_commitment": {
      "type": "object",
      "additionalProperties": true
    },
    "canonical_refs": {
      "type": "object",
      "additionalProperties": true
    },
    "active_workstreams": {
      "type": "object",
      "additionalProperties": true
    },
    "external_dependencies": {
      "type": "object",
      "additionalProperties": true
    },
    "non_blocking_validation": {
      "type": "object",
      "additionalProperties": true
    },
    "current_blockers": {
      "type": "array"
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "reopen_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "principles": {
      "type": "object",
      "additionalProperties": true
    },
    "initial_integrations": {
      "type": "object",
      "additionalProperties": true
    },
    "lari_pilot": {
      "type": "object",
      "additionalProperties": true
    },
    "human_gate_default": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "implementation_started": {
      "type": "boolean"
    },
    "accepted_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate",
          "status"
        ],
        "additionalProperties": true,
        "properties": {
          "gate": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence_level": {
            "type": "string"
          },
          "foundation_baseline_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "verified_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "tested_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "closed_at": {
            "type": "string"
          },
          "reopen_condition": {
            "type": "string"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
