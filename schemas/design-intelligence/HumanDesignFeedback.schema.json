      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "source_attribution": {
      "type": "string"
    },
    "rating": {
      "type": "string"
    },
    "target_element": {
      "type": "string"
    },
    "comments": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_reversible": {
      "type": "boolean"
    },
    "recorded_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
